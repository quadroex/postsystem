Project postsystem {
  database_type: 'PostgreSQL'
  Note: 'Система управління поштовими відправленнями. 20 предметних сутностей та audit_log.'
}

Table postal.app_users {
  Note: 'Працівники й службові користувачі; автори змін даних.'
  id uuid [pk, not null]
  username text [not null, unique]
  full_name text [not null]
  is_active boolean [not null]
}

Table postal.countries {
  Note: 'Країни поштових адрес.'
  id integer [pk, not null, increment]
  code char(2) [not null, unique]
  name text [not null, unique]
}

Table postal.cities {
  Note: 'Населені пункти з прив’язкою до країни.'
  id integer [pk, not null, increment]
  country_id integer [not null]
  name text [not null]
  indexes {
    (country_id, name) [unique]
  }
}

Table postal.addresses {
  Note: 'Адреси відділень.'
  id integer [pk, not null, increment]
  city_id integer [not null]
  street text [not null]
  building text [not null]
  postal_code text [not null]
  created_at timestamptz [not null]
  created_by uuid [not null]
  updated_at timestamptz [not null]
  updated_by uuid [not null]
  deleted_at timestamptz [null]
  deleted_by uuid [null]
}

Table postal.branches {
  Note: 'Поштові відділення приймання та видачі.'
  id integer [pk, not null, increment]
  code text [not null, unique]
  name text [not null]
  address_id integer [not null]
  is_operational boolean [not null]
  created_at timestamptz [not null]
  created_by uuid [not null]
  updated_at timestamptz [not null]
  updated_by uuid [not null]
  deleted_at timestamptz [null]
  deleted_by uuid [null]
}

Table postal.customers {
  Note: 'Відправники та одержувачі поштових відправлень.'
  id uuid [pk, not null]
  full_name text [not null]
  email text [not null]
  phone text [not null]
  created_at timestamptz [not null]
  created_by uuid [not null]
  updated_at timestamptz [not null]
  updated_by uuid [not null]
  deleted_at timestamptz [null]
  deleted_by uuid [null]
}

Table postal.service_types {
  Note: 'Види послуг доставки.'
  id integer [pk, not null, increment]
  code text [not null, unique]
  name text [not null]
  is_active boolean [not null]
}

Table postal.shipment_statuses {
  Note: 'Довідник станів відправлення.'
  id integer [pk, not null]
  code text [not null, unique]
  name text [not null]
  is_terminal boolean [not null]
}

Table postal.tariffs {
  Note: 'Чинний тариф кожного виду послуг.'
  id integer [pk, not null, increment]
  service_type_id integer [not null, unique]
  base_price numeric(12,2) [not null]
  price_per_kg numeric(12,2) [not null]
  insurance_rate numeric(6,4) [not null]
  max_weight_kg numeric(10,3) [not null]
}

Table postal.shipments {
  Note: 'Відправлення з учасниками, відділеннями, послугою та станом.'
  id uuid [pk, not null]
  tracking_number text [not null, unique]
  sender_id uuid [not null]
  recipient_id uuid [not null]
  origin_branch_id integer [not null]
  destination_branch_id integer [not null]
  service_type_id integer [not null]
  status_id integer [not null]
  declared_value numeric(12,2) [not null]
  price numeric(12,2) [not null]
  created_at timestamptz [not null]
  created_by uuid [not null]
  updated_at timestamptz [not null]
  updated_by uuid [not null]
  deleted_at timestamptz [null]
  deleted_by uuid [null]
}

Table postal.parcels {
  Note: 'Окремі пакунки в межах одного відправлення.'
  id uuid [pk, not null]
  shipment_id uuid [not null]
  description text [not null]
  weight_kg numeric(10,3) [not null]
  length_cm numeric(8,2) [not null]
  width_cm numeric(8,2) [not null]
  height_cm numeric(8,2) [not null]
  created_at timestamptz [not null]
  created_by uuid [not null]
}

Table postal.shipment_events {
  Note: 'Історія станів і місця обробки відправлення.'
  id uuid [pk, not null]
  shipment_id uuid [not null]
  status_id integer [not null]
  branch_id integer [not null]
  note text [not null]
  occurred_at timestamptz [not null]
  recorded_by uuid [not null]
}

Table postal.delivery_attempts {
  Note: 'Спроби вручення та їх результати.'
  id uuid [pk, not null]
  shipment_id uuid [not null]
  branch_id integer [not null]
  attempt_no integer [not null]
  outcome text [not null]
  note text [not null]
  attempted_at timestamptz [not null]
  recorded_by uuid [not null]
  indexes {
    (shipment_id, attempt_no) [unique]
  }
}

Table postal.payment_methods {
  Note: 'Способи оплати поштових послуг.'
  id integer [pk, not null, increment]
  code text [not null, unique]
  name text [not null]
  requires_reference boolean [not null]
  is_active boolean [not null]
}

Table postal.payments {
  Note: 'Оплати за відправленнями.'
  id uuid [pk, not null]
  shipment_id uuid [not null]
  amount numeric(12,2) [not null]
  payment_method_id integer [not null]
  reference text [null, unique]
  paid_at timestamptz [not null]
  recorded_by uuid [not null]
}

Table postal.vehicles {
  Note: 'Транспорт для перевезення відправлень.'
  id integer [pk, not null, increment]
  registration_number text [not null, unique]
  max_load_kg numeric(10,3) [not null]
  is_active boolean [not null]
}

Table postal.transport_routes {
  Note: 'Маршрути між відділеннями.'
  id integer [pk, not null, increment]
  name text [not null, unique]
  origin_branch_id integer [not null]
  destination_branch_id integer [not null]
}

Table postal.route_stops {
  Note: 'Впорядковані зупинки маршруту.'
  id integer [pk, not null, increment]
  route_id integer [not null]
  branch_id integer [not null]
  stop_order integer [not null]
  indexes {
    (route_id, stop_order) [unique]
    (route_id, branch_id) [unique]
  }
}

Table postal.transport_runs {
  Note: 'Рейси за маршрутом із призначеним транспортом.'
  id uuid [pk, not null]
  route_id integer [not null]
  vehicle_id integer [not null]
  departure_at timestamptz [not null]
  arrival_at timestamptz [null]
  status text [not null]
  created_by uuid [not null]
}

Table postal.run_shipments {
  Note: 'Зв’язок рейсів і відправлень, завантажених на рейс.'
  run_id uuid [not null]
  shipment_id uuid [not null, unique]
  loaded_at timestamptz [not null]
  loaded_by uuid [not null]
  indexes {
    (run_id, shipment_id) [pk]
    (shipment_id) [unique]
  }
}

Table postal.audit_log {
  Note: 'Технічний журнал змін із попереднім і новим вмістом запису.'
  id bigint [pk, not null, increment]
  entity_name text [not null]
  entity_id text [not null]
  operation text [not null]
  changed_at timestamptz [not null]
  changed_by uuid [not null]
  old_data jsonb [null]
  new_data jsonb [not null]
}

Ref: postal.cities.country_id > postal.countries.id
Ref: postal.addresses.city_id > postal.cities.id
Ref: postal.addresses.created_by > postal.app_users.id
Ref: postal.addresses.updated_by > postal.app_users.id
Ref: postal.addresses.deleted_by > postal.app_users.id
Ref: postal.branches.address_id > postal.addresses.id
Ref: postal.branches.created_by > postal.app_users.id
Ref: postal.branches.updated_by > postal.app_users.id
Ref: postal.branches.deleted_by > postal.app_users.id
Ref: postal.customers.created_by > postal.app_users.id
Ref: postal.customers.updated_by > postal.app_users.id
Ref: postal.customers.deleted_by > postal.app_users.id
Ref: postal.service_types.id - postal.tariffs.service_type_id
Ref: postal.shipments.sender_id > postal.customers.id
Ref: postal.shipments.recipient_id > postal.customers.id
Ref: postal.shipments.origin_branch_id > postal.branches.id
Ref: postal.shipments.destination_branch_id > postal.branches.id
Ref: postal.shipments.service_type_id > postal.service_types.id
Ref: postal.shipments.status_id > postal.shipment_statuses.id
Ref: postal.shipments.created_by > postal.app_users.id
Ref: postal.shipments.updated_by > postal.app_users.id
Ref: postal.shipments.deleted_by > postal.app_users.id
Ref: postal.parcels.shipment_id > postal.shipments.id
Ref: postal.parcels.created_by > postal.app_users.id
Ref: postal.shipment_events.shipment_id > postal.shipments.id
Ref: postal.shipment_events.status_id > postal.shipment_statuses.id
Ref: postal.shipment_events.branch_id > postal.branches.id
Ref: postal.shipment_events.recorded_by > postal.app_users.id
Ref: postal.delivery_attempts.shipment_id > postal.shipments.id
Ref: postal.delivery_attempts.branch_id > postal.branches.id
Ref: postal.delivery_attempts.recorded_by > postal.app_users.id
Ref: postal.payments.shipment_id > postal.shipments.id
Ref: postal.payments.payment_method_id > postal.payment_methods.id
Ref: postal.payments.recorded_by > postal.app_users.id
Ref: postal.transport_routes.origin_branch_id > postal.branches.id
Ref: postal.transport_routes.destination_branch_id > postal.branches.id
Ref: postal.route_stops.route_id > postal.transport_routes.id
Ref: postal.route_stops.branch_id > postal.branches.id
Ref: postal.transport_runs.route_id > postal.transport_routes.id
Ref: postal.transport_runs.vehicle_id > postal.vehicles.id
Ref: postal.transport_runs.created_by > postal.app_users.id
Ref: postal.run_shipments.run_id > postal.transport_runs.id
Ref: postal.shipments.id - postal.run_shipments.shipment_id
Ref: postal.run_shipments.loaded_by > postal.app_users.id
Ref: postal.audit_log.changed_by > postal.app_users.id
